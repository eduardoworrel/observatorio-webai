{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "laboratorio.schema.json",
  "title": "laboratorio (SPEC 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "entidade",
    "id",
    "nome",
    "instituicao",
    "vinculo_fonte",
    "links",
    "fontes"
  ],
  "properties": {
    "spec": {
      "const": "1.0"
    },
    "entidade": {
      "const": "laboratorio"
    },
    "exemplo": {
      "type": "boolean"
    },
    "status": {
      "$ref": "comum.schema.json#/$defs/status"
    },
    "arquivo": {
      "$ref": "comum.schema.json#/$defs/arquivo"
    },
    "descricao": {
      "$ref": "comum.schema.json#/$defs/texto_i18n"
    },
    "links": {
      "$ref": "comum.schema.json#/$defs/links"
    },
    "fontes": {
      "$ref": "comum.schema.json#/$defs/fontes"
    },
    "id": {
      "$ref": "comum.schema.json#/$defs/id"
    },
    "nome": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "sigla": {
      "type": "string",
      "maxLength": 20
    },
    "instituicao": {
      "$ref": "comum.schema.json#/$defs/id_instituicao"
    },
    "areas": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      }
    },
    "vinculo_fonte": {
      "$ref": "comum.schema.json#/$defs/evidencia"
    },
    "parceiras": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instituicao",
          "fonte"
        ],
        "properties": {
          "instituicao": {
            "$ref": "comum.schema.json#/$defs/id_instituicao"
          },
          "fonte": {
            "$ref": "comum.schema.json#/$defs/evidencia"
          }
        }
      }
    },
    "modelos_creditados": {
      "$ref": "comum.schema.json#/$defs/modelos_creditados"
    }
  }
}
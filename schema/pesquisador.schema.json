{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pesquisador.schema.json",
  "title": "pesquisador (SPEC 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "entidade",
    "id",
    "nome",
    "origem_cadastro",
    "afiliacoes",
    "links",
    "fontes"
  ],
  "properties": {
    "spec": {
      "const": "1.0"
    },
    "entidade": {
      "const": "pesquisador"
    },
    "exemplo": {
      "type": "boolean"
    },
    "status": {
      "$ref": "comum.schema.json#/$defs/status"
    },
    "arquivo": {
      "$ref": "comum.schema.json#/$defs/arquivo"
    },
    "descricao": {
      "$ref": "comum.schema.json#/$defs/texto_i18n"
    },
    "links": {
      "$ref": "comum.schema.json#/$defs/links"
    },
    "fontes": {
      "$ref": "comum.schema.json#/$defs/fontes"
    },
    "id": {
      "$ref": "comum.schema.json#/$defs/id"
    },
    "nome": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "origem_cadastro": {
      "enum": [
        "autoinscricao",
        "terceiro",
        "coletor"
      ]
    },
    "afiliacoes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "instituicao",
          "pais",
          "fonte"
        ],
        "additionalProperties": false,
        "properties": {
          "instituicao": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "pais": {
            "$ref": "comum.schema.json#/$defs/pais"
          },
          "laboratorio": {
            "$ref": "comum.schema.json#/$defs/id"
          },
          "papel": {
            "enum": [
              "docente",
              "pesquisador",
              "pos_graduacao",
              "engenharia",
              "independente"
            ]
          },
          "fonte": {
            "$ref": "comum.schema.json#/$defs/evidencia"
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      }
    },
    "publicacoes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "titulo",
          "ano",
          "fonte"
        ],
        "additionalProperties": false,
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "ano": {
            "type": "integer",
            "minimum": 1950,
            "maximum": 2100
          },
          "fonte": {
            "$ref": "comum.schema.json#/$defs/fonte"
          }
        }
      }
    },
    "modelos": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "modelo",
          "fonte"
        ],
        "additionalProperties": false,
        "properties": {
          "modelo": {
            "$ref": "comum.schema.json#/$defs/id_modelo"
          },
          "fonte": {
            "$ref": "comum.schema.json#/$defs/evidencia"
          }
        }
      }
    }
  }
}

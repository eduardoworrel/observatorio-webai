{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "familia.schema.json",
  "title": "familia (SPEC 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "entidade",
    "id",
    "nome",
    "fontes"
  ],
  "properties": {
    "spec": {
      "const": "1.0"
    },
    "entidade": {
      "const": "familia"
    },
    "exemplo": {
      "type": "boolean"
    },
    "status": {
      "$ref": "comum.schema.json#/$defs/status"
    },
    "arquivo": {
      "$ref": "comum.schema.json#/$defs/arquivo"
    },
    "descricao": {
      "$ref": "comum.schema.json#/$defs/texto_i18n"
    },
    "links": {
      "$ref": "comum.schema.json#/$defs/links"
    },
    "fontes": {
      "$ref": "comum.schema.json#/$defs/fontes"
    },
    "id": {
      "$ref": "comum.schema.json#/$defs/id"
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "origem": {
      "$ref": "comum.schema.json#/$defs/id_publicador"
    },
    "excecao_escopo_br": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motivo",
        "modelos",
        "fontes"
      ],
      "properties": {
        "motivo": {
          "const": "desenvolvedor"
        },
        "modelos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "comum.schema.json#/$defs/id_modelo"
          }
        },
        "fontes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "comum.schema.json#/$defs/evidencia"
          }
        }
      }
    }
  }
}

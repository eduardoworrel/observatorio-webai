{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark.schema.json",
  "title": "benchmark (SPEC 1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "entidade",
    "id",
    "nome",
    "descricao",
    "dominio",
    "tipo",
    "datasets",
    "links",
    "fontes"
  ],
  "properties": {
    "spec": {
      "const": "1.0"
    },
    "entidade": {
      "const": "benchmark"
    },
    "exemplo": {
      "type": "boolean"
    },
    "status": {
      "$ref": "comum.schema.json#/$defs/status"
    },
    "arquivo": {
      "$ref": "comum.schema.json#/$defs/arquivo"
    },
    "id": {
      "$ref": "comum.schema.json#/$defs/id"
    },
    "nome": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "sigla": {
      "type": "string",
      "maxLength": 20
    },
    "descricao": {
      "$ref": "comum.schema.json#/$defs/texto_i18n"
    },
    "dominio": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "geral",
          "vestibular_educacao",
          "juridico",
          "saude",
          "codigo",
          "matematica",
          "extracao_classificacao",
          "cultura_lingua",
          "outros"
        ]
      }
    },
    "idiomas": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      }
    },
    "tarefas": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 40
      }
    },
    "tipo": {
      "enum": [
        "conjunto",
        "avaliacao",
        "leaderboard"
      ]
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "comum.schema.json#/$defs/id_modelo"
      }
    },
    "criador": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "publicador": {
          "$ref": "comum.schema.json#/$defs/id_publicador"
        },
        "nome": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "fonte": {
          "$ref": "comum.schema.json#/$defs/evidencia"
        }
      }
    },
    "ano": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "artigo": {
          "$ref": "comum.schema.json#/$defs/url"
        },
        "site": {
          "$ref": "comum.schema.json#/$defs/url"
        },
        "leaderboard": {
          "$ref": "comum.schema.json#/$defs/url"
        },
        "codigo": {
          "$ref": "comum.schema.json#/$defs/url"
        }
      }
    },
    "fontes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "comum.schema.json#/$defs/evidencia"
      }
    }
  }
}